# --- Supabase (accounts, groups, chat, bookings) ---
# Both values are public by design; row-level security in the database protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY secret (Project Settings > API > service_role). Creates accounts and resets passwords.
SUPABASE_SERVICE_ROLE_KEY=
# Optional SERVER-ONLY secret used to find forgotten usernames. If unset, the service-role key is used.
# RECOVERY_PEPPER=
# Accounts sign in through a private, never-emailed address built from the username on this domain.
# Keep the default unless Supabase rejects it, then use any domain you control.
# NEXT_PUBLIC_RECOVERY_EMAIL_DOMAIN=recovery.therapia.invalid

# --- LiveKit (audio). Same names for Cloud and self-hosted: only the values change. ---
# Cloud example:  wss://your-project.livekit.cloud
# Self-hosted:    wss://live.yourdomain.com
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AI mascot (Ava). Keys stay on the server. Without any key the mascot simply stays quiet.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Order the models are tried in. Leave out deepseek to never send messages to DeepSeek.
# MASCOT_PROVIDERS=gemini,deepseek
# Most AI replies per day across the whole app (cost guard)
# MASCOT_DAILY_CAP=800

# Reminders (browser push notifications). Make a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact address the push services can use, e.g. mailto:you@example.com
VAPID_SUBJECT=
