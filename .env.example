# --- Supabase (accounts, groups, chat, bookings) ---
# Both values are public by design; row-level security in the database protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY secret (Project Settings > API > service_role). Creates accounts and resets passwords.
SUPABASE_SERVICE_ROLE_KEY=
# Accounts sign in through a private, never-emailed address built from the username on this domain.
# Keep the default unless Supabase rejects it, then use any domain you control.
# NEXT_PUBLIC_RECOVERY_EMAIL_DOMAIN=recovery.therapia.invalid

# --- LiveKit (audio). Same names for Cloud and self-hosted: only the values change. ---
# Cloud example:  wss://your-project.livekit.cloud
# Self-hosted:    wss://live.yourdomain.com
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
