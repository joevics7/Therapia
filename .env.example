# LiveKit. Same variable names for Cloud and self-hosted: only the values change.
# Cloud example:  wss://your-project.livekit.cloud
# Self-hosted:    wss://live.yourdomain.com
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Facilitator key. Anyone who enters it on the join screen can host, promote and remove people.
# Use a long random value. Later this becomes real facilitator accounts.
HOST_KEY=

# Invite code for women-only rooms (prototype: one shared code). Hand out via partner groups.
WOMEN_INVITE_CODE=
